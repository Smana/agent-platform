{
  "name": "room-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The broker's read-only room view, embedded from internal/humanapi/ui/dist",
  "license": "Apache-2.0",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --format=esm --target=es2022 --outfile=../internal/humanapi/ui/dist/app.js && cp src/index.html src/app.css ../internal/humanapi/ui/dist/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "markdown-it": "14.3.2"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
